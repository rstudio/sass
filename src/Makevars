PKG_LIBS = ./libsass/lib/libsass.a
PKG_CPPFLAGS = -I./libsass/include

STATLIB = libsass/lib/libsass.a

all: $(SHLIB) cleanup

$(SHLIB): $(STATLIB)

$(STATLIB):
	# Forward R's C++ flags via EXTRA_CXXFLAGS (not CXXFLAGS): a variable set on
	# the make command line would override libsass's own `?=`/`+=` appends,
	# silently dropping flags it needs (-I include, -fPIC, -O2, -std=c++11).
	# libsass's Makefile appends EXTRA_CXXFLAGS after its own flags.
	MAKEFLAGS= CC="$(CC)" CFLAGS="$(CFLAGS)" CXX="$(CXX)" EXTRA_CXXFLAGS="$(CXX17FLAGS)" AR="$(AR)" LDFLAGS="$(LDFLAGS)" $(MAKE) -C libsass

cleanup: $(SHLIB)
	@rm -f $(STATLIB)

clean:
	MAKEFLAGS= $(MAKE) -C libsass clean
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB)

.PHONY: all cleanup clean
